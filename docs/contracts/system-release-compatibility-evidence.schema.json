{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-mamono210.invalid/schemas/system-release-compatibility-evidence.schema.json",
  "title": "Phase 51 canonical evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "generation", "generationId", "current", "history", "supersedes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": {
      "type": "string",
      "enum": [
        "redmine-mcp-rc-identity",
        "redmine-mcp-rc-verification",
        "agent-runner-rc-identity",
        "agent-runner-rc-verification",
        "agent-runner-real-infrastructure-decision",
        "cross-component-compatibility",
        "release-compatibility-manifest",
        "phase51-final-verification"
      ]
    },
    "generation": { "type": "integer", "minimum": 1 },
    "generationId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "current": { "type": "object" },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["generation", "generationId", "snapshot", "invalidatedAt", "invalidationReason", "invalidatingDefectIssueId"],
        "properties": {
          "generation": { "type": "integer", "minimum": 1 },
          "generationId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "snapshot": { "type": "object" },
          "invalidatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
          "invalidationReason": { "type": "string", "minLength": 1 },
          "invalidatingDefectIssueId": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "supersedes": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
