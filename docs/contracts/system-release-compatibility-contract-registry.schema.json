{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-mamono210.invalid/schemas/system-release-compatibility-contract-registry.schema.json",
  "title": "Phase 51 contract semantic revision registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contracts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractId", "repository", "path", "semanticRevision", "sourceRevision",
          "sourceBlobSha", "owningPhase", "normative", "registrationState"
        ],
        "properties": {
          "contractId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "path": { "type": "string", "minLength": 1 },
          "semanticRevision": { "type": "integer", "minimum": 1 },
          "sourceRevision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
          "sourceBlobSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "owningPhase": { "type": "string", "minLength": 1 },
          "normative": { "type": "boolean" },
          "registrationState": { "type": "string", "enum": ["committed", "pending-first-commit"] }
        }
      }
    }
  }
}
