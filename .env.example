# Docker image versions
REDMINE_IMAGE=redmine:6.1.3
POSTGRES_IMAGE=postgres:17.10

# PostgreSQL test database
POSTGRES_DB=redmine
POSTGRES_USER=redmine
POSTGRES_PASSWORD=redmine

# Redmine HTTP endpoint
REDMINE_PORT=3000
REDMINE_URL=http://localhost:3000

# Test-only Rails secret. Do not reuse this value in production.
REDMINE_SECRET_KEY_BASE=redmine-mcp-test-only-secret-key-base

# Readiness check
REDMINE_WAIT_TIMEOUT=180
REDMINE_WAIT_INTERVAL=3
