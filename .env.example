# Docker Redmine test environment
POSTGRES_DB=redmine
POSTGRES_USER=redmine
POSTGRES_PASSWORD=redmine
REDMINE_PORT=3000

# MCP client connection settings for the local Docker test environment.
# These API keys are deterministic and valid only for the seeded local/CI test Redmine.
# Never reuse these values in a production Redmine instance.
REDMINE_URL=http://localhost:3000
REDMINE_API_KEY=0123456789abcdef0123456789abcdef01234567
REDMINE_WRITE_API_KEY=fedcba9876543210fedcba9876543210fedcba98

# Write operations are disabled by default.
# REDMINE_ALLOWED_PROJECTS is a comma-separated list of Redmine project identifiers.
# An empty or unset allowlist permits no write operations.
REDMINE_WRITE_ENABLED=false
REDMINE_ALLOWED_PROJECTS=mcp-test

# Agent Brief approval storage settings.
# These are required only when REDMINE_WRITE_ENABLED=true so that the guarded
# redmine_approve_agent_brief Tool can resolve the exact Phase 37 persisted Brief.
# AGENT_BRIEF_REPOSITORY_ROOT=/absolute/path/to/target/repository
# AGENT_BRIEF_REPOSITORY=mcp-mamono210/redmine
# AGENT_BRIEF_CANONICAL_BRANCH=main
# AGENT_BRIEF_REQUIREMENT_CUSTOM_FIELD_IDS=
